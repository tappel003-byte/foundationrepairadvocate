---
import { NAV, PHONE, PHONE_TEL } from '../lib/site.ts';
---

<header class="site-header">
  <div class="header-inner header-inner--stacked">
    <a href="/" class="logo" aria-label="Foundation Repair Advocate — White Mountains, Arizona — home">
      <img
        src="/logo.svg"
        alt="Foundation Repair Advocate — White Mountains, Arizona"
        class="logo-img"
        width="320"
        height="130"
      />
    </a>

    <div class="header-bottom">
      <nav class="nav-links" aria-label="Main">
        {NAV.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
      <a class="phone-link" href={`tel:${PHONE_TEL}`}>{PHONE}</a>
    </div>
  </div>
</header>
