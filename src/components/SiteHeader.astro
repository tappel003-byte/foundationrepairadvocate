---
import { NAV, PHONE, PHONE_TEL, SITE_NAME } from '../lib/site.ts';
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <img src="/logo.svg" alt="Foundation Repair Advocate — White Mountains, Arizona" class="logo-img" width="180" height="72" />
      <span class="visually-hidden">{SITE_NAME}</span>
    </a>
    <nav class="nav-links" aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <a class="phone-link" href={`tel:${PHONE_TEL}`}>{PHONE}</a>
  </div>
</header>
