---
import { NAV, PHONE, PHONE_TEL, LOGO_TAGLINE } from '../lib/site.ts';
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="wordmark" aria-label="Foundation Repair Advocate — home">
      <span class="wordmark-top">Foundation Repair</span>
      <span class="wordmark-main">Advocate</span>
      <span class="wordmark-rule" aria-hidden="true"></span>
      <span class="wordmark-tagline">{LOGO_TAGLINE}</span>
    </a>
    <nav class="nav-links" aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <a class="phone-link" href={`tel:${PHONE_TEL}`}>{PHONE}</a>
  </div>
</header>
