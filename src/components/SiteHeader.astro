---
import { NAV, PHONE, PHONE_TEL } from '../lib/site.ts';
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="wordmark" aria-label="Foundation Repair Advocate — home">
      <img
        class="logo-img"
        src="/logo.svg"
        alt="Foundation Repair Advocate"
        width="240"
        height="60"
        decoding="async"
      />
    </a>
    <nav class="nav-links" aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <a class="phone-link" href={`tel:${PHONE_TEL}`}>{PHONE}</a>
  </div>
</header>
