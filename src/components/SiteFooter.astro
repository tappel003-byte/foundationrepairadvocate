---
import { NAV, PHONE, PHONE_TEL, SITE_NAME } from '../lib/site.ts';
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-brand">{SITE_NAME}</p>
    <p class="footer-tag">Independent second opinions & floor elevation surveys — Arizona</p>

    <nav class="footer-nav" aria-label="Footer">
      <a href="/">Home</a>
      {NAV.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <p class="footer-phone">
      <a class="phone-link" href={`tel:${PHONE_TEL}`}>{PHONE}</a>
    </p>

    <p class="disclaimer">
      We provide independent floor elevation surveys and practical second opinions.
      We are not a foundation repair contractor and we do not sell piers or structural repair.
      When stamped engineering is the right next step, we say so.
    </p>

    <p class="footer-copy">© {new Date().getFullYear()} Foundation Repair Advocate</p>
  </div>
</footer>
