---
import { NAV, PHONE, PHONE_TEL } from '../lib/site.ts';
---

<footer class="site-footer">
  <div class="footer-inner">
    <nav class="footer-nav" aria-label="Footer">
      <a href="/">Home</a>
      {NAV.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <p class="footer-contact">
      <a class="footer-phone" href={`tel:${PHONE_TEL}`}>{PHONE}</a>
      <span> — call or text</span>
    </p>
    <p class="disclaimer">
      Foundation Repair Advocate provides independent floor elevation surveys and practical second
      opinions for Arizona homeowners. We are not a foundation repair contractor, not a home
      inspection company, and not a licensed Arizona engineering firm. We do not sell piers or
      structural repair. See our full
      <a href="/disclosure/">scope &amp; disclosure</a>.
    </p>
    <p>© {new Date().getFullYear()} Foundation Repair Advocate. All rights reserved.</p>
  </div>
</footer>
