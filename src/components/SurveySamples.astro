---
/**
 * Side-by-side sample floor elevation surveys: settlement vs heave.
 * Illustrative only — not a real property. Same plan; a few points changed.
 */

const samples = [
  {
    src: '/images/sample-settlement.jpg',
    alt: 'Theoretical floor elevation survey map labeled settlement, with a low point toward the upper-left perimeter',
    width: 1488,
    height: 1162,
    label: 'Settlement',
    caption:
      'The pattern looks a lot like the heave map next to it. On this theoretical survey the low sits toward the perimeter — perhaps at a cut-and-fill transition. Pattern is not enough; where the movement is, and whether someone will say that plainly, is what you\'re paying for.',
  },
  {
    src: '/images/sample-heave.jpg',
    alt: 'Theoretical floor elevation survey map labeled heave, with a high of 10.0 in the kitchen',
    width: 1419,
    height: 1123,
    label: 'Heave',
    caption:
      'Same plan, nearly the same contours; a couple of points were changed. Here the high is in the kitchen at 10.0 — a location that often suggests moisture under the slab. If no one connects the high to where you\'re seeing damage, they\'re probably not acting in your best interest, or they\'re misreading the data.',
  },
];
---

<section class="survey-samples" aria-labelledby="survey-samples-heading">
  <h2 id="survey-samples-heading">What a floor survey looks like</h2>
  <p class="lead">
    Two theoretical surveys of the same floor plan. The contour patterns look very similar — only a
    couple of measurement points were changed. What separates settlement from heave is not the shape
    on the page alone, but where the high and low actually land, and whether that matches what you
    see in the house.
  </p>

  <p class="survey-legend">
    <strong>Reading the colors:</strong> green areas are the <em>higher</em> relative readings; dark
    brown areas are the <em>lower</em> relative readings. Click either map to enlarge.
  </p>

  <div class="survey-pair">
    {samples.map((sample) => (
      <figure class="survey-figure">
        <button
          type="button"
          class="survey-enlarge"
          data-survey-src={sample.src}
          data-survey-alt={sample.alt}
          data-survey-label={sample.label}
          aria-label={`Enlarge ${sample.label} floor survey map`}
        >
          <img
            src={sample.src}
            alt={sample.alt}
            width={sample.width}
            height={sample.height}
            loading="lazy"
          />
          <span class="survey-enlarge-hint">Click to enlarge</span>
        </button>
        <figcaption>
          <strong>{sample.label}</strong> — {sample.caption}
        </figcaption>
      </figure>
    ))}
  </div>

  <p class="survey-note">
    These are <em>sample</em> maps for education — not a real address. A real visit uses your floor
    plan and measured points. Pattern alone is not a diagnosis; an honest read of where the high and
    low points fall — and how that matches the rooms — still applies.
    <a href="/disclosure/">See scope &amp; disclosure</a>.
  </p>
</section>

<dialog class="survey-lightbox" id="survey-lightbox" aria-labelledby="survey-lightbox-title">
  <div class="survey-lightbox-inner">
    <button type="button" class="survey-lightbox-close" aria-label="Close enlarged map">×</button>
    <p class="survey-lightbox-title" id="survey-lightbox-title"></p>
    <img src="" alt="" class="survey-lightbox-img" />
  </div>
</dialog>

<script>
  const dialog = document.getElementById('survey-lightbox') as HTMLDialogElement | null;
  const title = dialog?.querySelector('.survey-lightbox-title') as HTMLElement | null;
  const img = dialog?.querySelector('.survey-lightbox-img') as HTMLImageElement | null;
  const closeBtn = dialog?.querySelector('.survey-lightbox-close') as HTMLButtonElement | null;

  document.querySelectorAll<HTMLButtonElement>('[data-survey-src]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog || !title || !img) return;
      img.src = button.dataset.surveySrc ?? '';
      img.alt = button.dataset.surveyAlt ?? '';
      title.textContent = button.dataset.surveyLabel ?? 'Floor survey map';
      dialog.showModal();
    });
  });

  closeBtn?.addEventListener('click', () => dialog?.close());

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog?.addEventListener('cancel', () => dialog.close());
</script>
