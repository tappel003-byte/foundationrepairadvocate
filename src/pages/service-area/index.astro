---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PHONE, PHONE_TEL } from '../../lib/site.ts';
---

<BaseLayout
  title="Service area"
  description="Foundation Repair Advocate serves Arizona — Show Low, White Mountains, Pinetop, Payson, Flagstaff, and Phoenix metro by appointment."
>
  <div class="container">
    <h1 class="page-title">Service area</h1>
    <p class="lead">
      Based in northern Arizona (928). We serve homeowners statewide by scheduled appointment.
    </p>

    <section>
      <h2>White Mountains & northern AZ</h2>
      <p>
        Our home turf — where independent measurement is scarce and repair sales visits are common from the Valley:
      </p>
      <ul class="check-list">
        <li>Show Low, Pinetop-Lakeside, Snowflake, Taylor</li>
        <li>Heber-Overgaard, Holbrook, Winslow</li>
        <li>Payson, Flagstaff, Prescott area (by schedule)</li>
      </ul>
      <p>
        We can often batch visits when several homeowners are ready in the same window.
      </p>
    </section>

    <section>
      <h2>Phoenix metro & southern AZ</h2>
      <p>
        Greater Phoenix, Tucson, and surrounding communities — by appointment. Higher competition means second opinions matter even more. We travel when the job warrants it.
      </p>
    </section>

    <section>
      <h2>Call or text</h2>
      <div class="contact-box">
        <a class="phone-link" href={`tel:${PHONE_TEL}`}>{PHONE}</a>
      </div>
    </section>
  </div>
</BaseLayout>
